<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        
        <!-- Package Information -->
        <Version>1.3.5-rc2</Version>
        <PackageId>Nimbbl.Sdk.Rest</PackageId>
        <Authors>Nimbbl</Authors>
        <Company>Nimbbl</Company>
        <Product>Nimbbl .NET SDK</Product>
        <Description>Official .NET SDK for Nimbbl Payment Gateway API. Provides comprehensive APIs for payment processing, order management, and checkout utilities.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/nimbbl-tech/nimbbl-dotnet-sdk</PackageProjectUrl>
        <RepositoryUrl>https://github.com/nimbbl-tech/nimbbl-dotnet-sdk</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>nimbbl;payment;gateway;sdk;dotnet;aspnetcore;rest;api</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        
        <!-- Include XML documentation -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
        
        <!-- Include debug symbols in published package (standard practice) -->
        <!-- Embedded PDBs: Symbols are embedded directly in the DLL, making them always available -->
        <!-- This enables accurate stack traces with file names and line numbers for consumers -->
        <DebugType>embedded</DebugType>
        <DebugSymbols>true</DebugSymbols>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    </ItemGroup>
    
    <!-- Include README in package -->
    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
