# Nimbbl .NET SDK Configuration
# Copy this file to .env and fill in your credentials
# DO NOT commit .env to version control

# Required: API Credentials
# Get these from your Nimbbl merchant dashboard: https://commandcenter.nimbbl.tech/
# Navigate to Developer Settings → Credentials
NIMBBL_ACCESS_KEY=your_access_key_here
NIMBBL_ACCESS_SECRET=your_access_secret_here

# Optional: API Configuration
# Production: https://api.nimbbl.tech
# UAT: https://apipp.nimbbl.tech
# QA2: https://qa2api.nimbbl.tech
NIMBBL_API_HOST=https://qa2api.nimbbl.tech

# Optional: Logging Configuration
# INFO/WARNING/ERROR logs are always on; NIMBBL_DEBUG_LOGGING toggles DEBUG verbosity only.
NIMBBL_LOG_FILE=logs/nimbbl_debug.log
NIMBBL_DEBUG_LOGGING=true


# Optional: Enable encryption for request payloads (outgoing)
# Set to "true" to encrypt order creation and other API request payloads
# When enabled, the application will encrypt request payloads before sending them to the Nimbbl API
# Default: false
ENCRYPT_PAYLOAD=false
