# Nimbbl .NET SDK Test Configuration
# Copy this file to .env and update with your credentials

# Required: Your Nimbbl access key
NIMBBL_ACCESS_KEY=your_access_key_here

# Required: Your Nimbbl access secret
NIMBBL_ACCESS_SECRET=your_access_secret_here

# Optional: API host URL (defaults to production if not set)
# NIMBBL_API_HOST=https://api.nimbbl.tech

# Optional: Enable payload encryption (defaults to false if not set)
ENCRYPT_PAYLOAD=false

